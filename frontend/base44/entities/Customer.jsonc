{
  // Entity Schema: Customer
  "name": "Customer",
  "description": "Hotel and restaurant customers profile",
  "fields": {
    "id": { "type": "string", "required": true, "description": "Unique customer ID (UUID)" },
    "fullName": { "type": "string", "required": true, "description": "Full name of the customer" },
    "email": { "type": "string", "format": "email", "required": false, "description": "Contact email address" },
    "phone": { "type": "string", "required": true, "description": "Primary contact phone number" },
    "address": { "type": "string", "required": false, "description": "Residential address or city" },
    "idProofType": { "type": "string", "required": false, "description": "Type of ID provided (Aadhaar, Passport, etc.)" },
    "idProofNumber": { "type": "string", "required": false, "description": "Masked or verified ID document number" },
    "notes": { "type": "string", "required": false, "description": "Internal customer preferences or notes" },
    "createdAt": { "type": "string", "format": "date-time", "required": true, "description": "Creation timestamp" }
  },
  "relations": {
    "bookings": {
      "type": "hasMany",
      "entity": "Booking",
      "foreignKey": "customerId"
    },
    "orders": {
      "type": "hasMany",
      "entity": "Order",
      "foreignKey": "customerId"
    }
  }
}

