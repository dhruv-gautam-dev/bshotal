{
  "name": "Setting",
  "type": "object",
  "properties": {
    "hotel_name": {
      "type": "string"
    },
    "tagline_en": {
      "type": "string"
    },
    "tagline_hi": {
      "type": "string"
    },
    "phone_primary": {
      "type": "string"
    },
    "phone_secondary": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "address_en": {
      "type": "string"
    },
    "address_hi": {
      "type": "string"
    },
    "hours_en": {
      "type": "string"
    },
    "hours_hi": {
      "type": "string"
    },
    "fssai": {
      "type": "string"
    },
    "gst": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "tax_percent": {
      "type": "number",
      "default": 0
    },
    "delivery_charge": {
      "type": "number",
      "default": 0
    },
    "delivery_radius_km": {
      "type": "number",
      "default": 0
    },
    "min_order": {
      "type": "number",
      "default": 0
    },
    "advance_percent": {
      "type": "number",
      "default": 0
    },
    "checkin_time": {
      "type": "string",
      "default": "12:00"
    },
    "checkout_time": {
      "type": "string",
      "default": "10:00"
    },
    "cancellation_policy": {
      "type": "string"
    },
    "notify_email": {
      "type": "boolean",
      "default": true
    },
    "notify_whatsapp_hook": {
      "type": "string"
    }
  },
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}