{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "category_id": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "name_hi": {
      "type": "string"
    },
    "desc": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "is_veg": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "sort": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name_en",
    "price",
    "category_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}