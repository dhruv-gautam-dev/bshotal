{
  "name": "User",
  "type": "object",
  "properties": {
    "staff_role": {
      "type": "string",
      "enum": [
        "owner",
        "manager",
        "staff",
        "none"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "gray"
      ],
      "default": "none",
      "description": "Staff permission level. Locked: only an owner/admin can change it",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "staff_active": {
      "type": "boolean",
      "default": true,
      "description": "Set false to revoke dashboard access without deleting the account",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "staff_phone": {
      "type": "string"
    }
  }
}