{
  "name": "EventPackage",
  "type": "object",
  "properties": {
    "title_en": {
      "type": "string"
    },
    "title_hi": {
      "type": "string"
    },
    "desc_en": {
      "type": "string"
    },
    "desc_hi": {
      "type": "string"
    },
    "capacity": {
      "type": "string"
    },
    "price_from": {
      "type": "number"
    },
    "price_to": {
      "type": "number"
    },
    "inclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title_en"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}