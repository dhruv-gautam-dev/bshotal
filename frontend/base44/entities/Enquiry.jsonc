{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "ring",
        "birthday",
        "wedding",
        "custom",
        "contact"
      ],
      "enumColors": [
        "pink",
        "purple",
        "blue",
        "gray",
        "yellow"
      ],
      "default": "contact"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "event_date": {
      "type": "string"
    },
    "guests": {
      "type": "number"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "quote_sent",
        "confirmed",
        "lost"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "purple",
        "green",
        "red"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.status": "new"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}