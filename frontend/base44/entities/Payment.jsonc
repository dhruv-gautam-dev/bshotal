{
  "name": "PricingRule",
  "type": "object",
  "properties": {
    "room_type_id": {
      "type": "string"
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "room_type_id",
    "start_date",
    "end_date",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    }
  }
}