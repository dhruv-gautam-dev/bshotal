{
  "name": "Room",
  "type": "object",
  "properties": {
    "number": {
      "type": "string"
    },
    "room_type_id": {
      "type": "string"
    },
    "floor": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "occupied",
        "cleaning",
        "maintenance"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "red"
      ],
      "default": "available"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "number",
    "room_type_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}