{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "actor_email": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "entity": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "staff"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}