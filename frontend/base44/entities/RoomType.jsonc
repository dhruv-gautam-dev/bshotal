{
  "name": "RoomType",
  "type": "object",
  "properties": {
    "name_en": {
      "type": "string"
    },
    "name_hi": {
      "type": "string"
    },
    "desc_en": {
      "type": "string"
    },
    "desc_hi": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "capacity": {
      "type": "number"
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_rooms": {
      "type": "number",
      "default": 1
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name_en",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}