{
  "name": "Order",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "dine-in",
        "pickup",
        "delivery"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ],
      "default": "dine-in"
    },
    "table_no": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "qty": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "delivery": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "accepted",
        "preparing",
        "ready",
        "out_for_delivery",
        "served",
        "completed",
        "cancelled"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "purple",
        "blue",
        "pink",
        "green",
        "green",
        "red"
      ],
      "default": "new"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "unpaid"
    },
    "payment_mode": {
      "type": "string",
      "enum": [
        "cash",
        "upi",
        "card",
        "online",
        "none"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple",
        "pink",
        "gray"
      ],
      "default": "none"
    },
    "assigned_to": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "phone",
        "walkin",
        "dine_in"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "gray"
      ],
      "default": "website"
    }
  },
  "required": [
    "customer_name",
    "phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.status": "new"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    }
  }
}