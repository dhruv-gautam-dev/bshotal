{
  // Entity Schema: Booking
  "name": "Booking",
  "description": "Room reservation records for guests",
  "fields": {
    "id": { "type": "string", "required": true, "description": "Unique booking identifier (UUID)" },
    "bookingNumber": { "type": "string", "required": true, "description": "Human-friendly booking reference (e.g., BSH-2026-001)" },
    "customerId": { "type": "string", "required": true, "description": "ID of guest / customer" },
    "roomId": { "type": "string", "required": true, "description": "Assigned room ID" },
    "checkInDate": { "type": "string", "format": "date", "required": true, "description": "Check-in date" },
    "checkOutDate": { "type": "string", "format": "date", "required": true, "description": "Check-out date" },
    "guestsCount": { "type": "integer", "required": true, "description": "Total number of guests" },
    "totalAmount": { "type": "number", "required": true, "description": "Total cost of booking" },
    "status": { "type": "string", "enum": ["pending", "confirmed", "checked_in", "checked_out", "cancelled"], "required": true, "description": "Booking status" },
    "paymentStatus": { "type": "string", "enum": ["unpaid", "partially_paid", "paid", "refunded"], "required": true, "description": "Payment status" },
    "specialRequests": { "type": "string", "required": false, "description": "Special guest instructions or requests" },
    "createdAt": { "type": "string", "format": "date-time", "required": true, "description": "Creation timestamp" },
    "updatedAt": { "type": "string", "format": "date-time", "required": true, "description": "Last update timestamp" }
  },
  "relations": {
    "customer": {
      "type": "belongsTo",
      "entity": "Customer",
      "foreignKey": "customerId"
    },
    "room": {
      "type": "belongsTo",
      "entity": "Room",
      "foreignKey": "roomId"
    },
    "payments": {
      "type": "hasMany",
      "entity": "Payment",
      "foreignKey": "bookingId"
    }
  }
}

