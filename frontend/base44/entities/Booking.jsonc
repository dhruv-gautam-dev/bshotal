{
  "name": "Booking",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "room_type_id": {
      "type": "string"
    },
    "room_type_name": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "room_number": {
      "type": "string"
    },
    "check_in": {
      "type": "string"
    },
    "check_out": {
      "type": "string"
    },
    "nights": {
      "type": "number"
    },
    "guests": {
      "type": "number"
    },
    "special_requests": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "advance_paid": {
      "type": "number"
    },
    "balance": {
      "type": "number"
    },
    "payment_mode": {
      "type": "string",
      "enum": [
        "cash",
        "upi",
        "card",
        "online",
        "none"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple",
        "pink",
        "gray"
      ],
      "default": "none"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "checked_in",
        "checked_out",
        "cancelled",
        "no_show"
      ],
      "enumColors": [
        "yellow",
        "green",
        "blue",
        "gray",
        "red",
        "red"
      ],
      "default": "pending"
    },
    "cancel_reason": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "phone",
        "walkin",
        "whatsapp"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "gray"
      ],
      "default": "website"
    },
    "notes": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "guest_name",
    "phone",
    "check_in",
    "check_out"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.status": "pending"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.staff_role": "manager"
          }
        }
      ]
    }
  }
}