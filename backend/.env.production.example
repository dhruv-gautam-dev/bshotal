# B.S. Hotel & Restaurant - Production Environment Template
PROJECT_NAME="B.S. Hotel & Restaurant API"
APP_ENV="production"
ENVIRONMENT="production"
DEBUG=False
API_V1_PREFIX="/api/v1"

# Database: Supabase PostgreSQL
# Runtime App: Port 6543 (Transaction Pooler - supports 10,000+ connections)
DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?ssl=require"
# Migrations: Port 5432 (Session Pooler or Direct Connection - required for transactional DDL)
DIRECT_DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?ssl=require"

# Supabase API & File Storage
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[PASTE-SECRET-SERVICE-ROLE-KEY-HERE]"
SUPABASE_ANON_KEY="[PASTE-PUBLIC-ANON-KEY-HERE]"
SUPABASE_STORAGE_BUCKET_ROOMS="room-photos"
SUPABASE_STORAGE_BUCKET_MENU="menu-photos"
SUPABASE_STORAGE_BUCKET_GALLERY="gallery"

# Connection Pool Tuning (Tailored for Supabase compute limits)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=True
STATEMENT_CACHE_SIZE=0

# Security (Generate with: openssl rand -hex 32)
SECRET_KEY="[GENERATE-STRONG-64-CHARACTER-HEX-SECRET-KEY]"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Domain CORS & Host Header Security
CORS_ORIGINS='["https://bshotel.in","https://www.bshotel.in"]'
ALLOWED_HOSTS='["bshotel.in","www.bshotel.in","api.bshotel.in"]'

# Initial Production Owner Account
INITIAL_OWNER_EMAIL="owner@bshotel.in"
INITIAL_OWNER_PHONE="+919149224039"
INITIAL_OWNER_PASSWORD="[GENERATE-STRONG-OWNER-PASSWORD]"
INITIAL_OWNER_NAME="Owner / Director"

# Contact Info
HOTEL_BOOKINGS_PHONE="+919149224039"
HOTEL_PAYMENTS_PHONE="+919259273735"
HOTEL_ADDRESS="Near Township Nagar, NH-2, Mathura, Uttar Pradesh - 281006"

# Email Notifications (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@bshotel.in"
SMTP_PASSWORD="[GMAIL-APP-PASSWORD]"
EMAILS_FROM_EMAIL="bookings@bshotel.in"
EMAILS_FROM_NAME="B.S. Hotel & Restaurant"

# Observability (Optional)
# SENTRY_DSN="https://..."

