# B.S. Hotel & Restaurant - Development Environment Template
PROJECT_NAME="B.S. Hotel & Restaurant API (Dev)"
APP_ENV="development"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database: Local SQLite or Dev Supabase Transaction Pooler
# For local SQLite: sqlite+aiosqlite:///./bshotel.db
# For Dev Supabase: postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL="sqlite+aiosqlite:///./bshotel.db"
# DIRECT_DATABASE_URL="postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?ssl=require"

# Supabase Storage & Keys
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJh..."
SUPABASE_ANON_KEY="eyJh..."
SUPABASE_STORAGE_BUCKET_ROOMS="room-photos"
SUPABASE_STORAGE_BUCKET_MENU="menu-photos"
SUPABASE_STORAGE_BUCKET_GALLERY="gallery"

# Security
SECRET_KEY="dev_jwt_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]'
ALLOWED_HOSTS='["*"]'

# Initial Owner Seed
INITIAL_OWNER_EMAIL="owner@bshotel.com"
INITIAL_OWNER_PHONE="+919149224039"
INITIAL_OWNER_PASSWORD="Bshotel@Admin2026"
INITIAL_OWNER_NAME="General Manager"

# Contact Info
HOTEL_BOOKINGS_PHONE="+919149224039"
HOTEL_PAYMENTS_PHONE="+919259273735"
HOTEL_ADDRESS="Near Township Nagar, NH-2, Mathura, Uttar Pradesh - 281006"

